{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://graminlink-api.onrender.com/api/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" }
      ]
    }
  ]
}
